$light-border-subtle: #e6e9ee;
$light-border: #d9dde4;
$light-border-strong: #b9c0cc;
$light-accent-border: var(--aui-theme-accent-border);
$light-success-border: var(--aui-theme-success-border);
$light-warning-border: var(--aui-theme-warning-border);
$light-danger-border: var(--aui-theme-danger-border);
$light-info-border: var(--aui-theme-info-border);
$light-accent: var(--aui-theme-accent);

[data-aui-theme="light"] {
  --aui-theme-border-subtle: #e6e9ee;
  --aui-theme-border: #d9dde4;
  --aui-theme-border-strong: #b9c0cc;
  --aui-theme-divider: #e6e9ee;

  --aui-theme-line: 1px solid #{$light-border};
  --aui-theme-line-subtle: 1px solid #{$light-border-subtle};
  --aui-theme-line-strong: 1px solid #{$light-border-strong};
  --aui-theme-line-dashed: 1px dashed #{$light-border-strong};

  --aui-theme-line-accent: 1px solid #{$light-accent-border};
  --aui-theme-line-success: 1px solid #{$light-success-border};
  --aui-theme-line-warning: 1px solid #{$light-warning-border};
  --aui-theme-line-danger: 1px solid #{$light-danger-border};
  --aui-theme-line-info: 1px solid #{$light-info-border};
  --aui-theme-line-focus: 2px solid #{$light-accent};
}
