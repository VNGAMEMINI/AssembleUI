@use "../../primitives/border" as *;

$light-border-subtle: #e6e9ee;
$light-border: #d9dde4;
$light-border-strong: #b9c0cc;
$light-accent-border: var(--aui-theme-accent-border);
$light-success-border: var(--aui-theme-success-border);
$light-warning-border: var(--aui-theme-warning-border);
$light-danger-border: var(--aui-theme-danger-border);
$light-info-border: var(--aui-theme-info-border);
$light-accent: var(--aui-theme-accent);

[data-aui-theme="light"] {
  --aui-theme-border-subtle: #e6e9ee;
  --aui-theme-border: #d9dde4;
  --aui-theme-border-strong: #b9c0cc;
  --aui-theme-divider: #e6e9ee;
  --aui-theme-line: #{$border-width-default} #{$border-style-solid}
    #{$light-border};
  --aui-theme-line-subtle: #{$border-width-default} #{$border-style-solid}
    #{$light-border-subtle};
  --aui-theme-line-strong: #{$border-width-default} #{$border-style-solid}
    #{$light-border-strong};
  --aui-theme-line-dashed: #{$border-width-default} #{$border-style-dashed}
    #{$light-border-strong};
  --aui-theme-line-accent: #{$border-width-default} #{$border-style-solid}
    #{$light-accent-border};
  --aui-theme-line-success: #{$border-width-default} #{$border-style-solid}
    #{$light-success-border};
  --aui-theme-line-warning: #{$border-width-default} #{$border-style-solid}
    #{$light-warning-border};
  --aui-theme-line-danger: #{$border-width-default} #{$border-style-solid}
    #{$light-danger-border};
  --aui-theme-line-info: #{$border-width-default} #{$border-style-solid}
    #{$light-info-border};
  --aui-theme-line-focus: #{$border-width-medium} #{$border-style-solid}
    #{$light-accent};
}
