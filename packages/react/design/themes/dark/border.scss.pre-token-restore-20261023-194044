$dark-border-subtle: #1f2935;
$dark-border: #2b3645;
$dark-border-strong: #435064;
$dark-accent-border: var(--aui-theme-accent-border);
$dark-success-border: var(--aui-theme-success-border);
$dark-warning-border: var(--aui-theme-warning-border);
$dark-danger-border: var(--aui-theme-danger-border);
$dark-info-border: var(--aui-theme-info-border);
$dark-accent: var(--aui-theme-accent);

[data-aui-theme="dark"] {
  --aui-theme-border-subtle: #1f2935;
  --aui-theme-border: #2b3645;
  --aui-theme-border-strong: #435064;
  --aui-theme-divider: #1f2935;

  --aui-theme-line: 1px solid #{$dark-border};
  --aui-theme-line-subtle: 1px solid #{$dark-border-subtle};
  --aui-theme-line-strong: 1px solid #{$dark-border-strong};
  --aui-theme-line-dashed: 1px dashed #{$dark-border-strong};

  --aui-theme-line-accent: 1px solid #{$dark-accent-border};
  --aui-theme-line-success: 1px solid #{$dark-success-border};
  --aui-theme-line-warning: 1px solid #{$dark-warning-border};
  --aui-theme-line-danger: 1px solid #{$dark-danger-border};
  --aui-theme-line-info: 1px solid #{$dark-info-border};
  --aui-theme-line-focus: 2px solid #{$dark-accent};
}
