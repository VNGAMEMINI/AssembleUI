{
  "name": "@vnallmini/react",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/styles.css",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "!README.md.bak"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns/index.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "import": "./dist/templates/index.js"
    },
    "./styles": "./dist/styles.css",
    "./themes/dark": "./dist/themes/dark.css",
    "./themes/light": "./dist/themes/light.css"
  },
  "scripts": {
    "build:styles": "mkdir -p dist/themes && sass --no-source-map index.scss dist/styles.css && sass --no-source-map design/themes/dark/index.scss dist/themes/dark.css && sass --no-source-map design/themes/light/index.scss dist/themes/light.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "description": "An open-source React UI library for reusable components, patterns, and templates.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VNGAMEMINI/AssembleUI.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/VNGAMEMINI/AssembleUI#readme",
  "bugs": {
    "url": "https://github.com/VNGAMEMINI/AssembleUI/issues"
  }
}
