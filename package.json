{
  "name": "assembleui",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:types && npm run build:styles",
    "build:types": "tsc --project tsconfig.build.json",
    "build:styles": "npm --workspace @assemble-ui/react run build:styles",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VNGAMEMINI/AssembleUI.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/VNGAMEMINI/AssembleUI/issues"
  },
  "homepage": "https://github.com/VNGAMEMINI/AssembleUI#readme",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "sass": "^1.102.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "packages/*"
  ]
}
