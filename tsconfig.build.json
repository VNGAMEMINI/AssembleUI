{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./packages/react/dist",
    "rootDir": "./packages/react"
  },
  "include": [
    "packages/react/index.ts",
    "packages/react/components/index.ts",
    "packages/react/patterns/index.ts",
    "packages/react/templates/index.ts"
  ],
  "exclude": [
    "packages/react/dist",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
